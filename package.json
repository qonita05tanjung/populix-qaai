{
  "name": "populix-qaai-3",
  "type": "module",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.20.0",
    "@wdio/cli": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "allure-commandline": "^2.34.1",
    "axios": "^1.12.2",
    "dotenv": "^17.2.2",
    "mocha": "^11.7.2",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "eval:matrics": "node --import tsx ./node_modules/mocha/bin/_mocha --extension ts \"eval-matrics/test/spec/eval.ts\" --timeout 300000 --reporter mochawesome --reporter-options reportDir=reports,reportFilename=mocha-report,overwrite=false,html=true,json=true",
    "report:merge": "mochawesome-merge reports/*.json > reports/report.json",
    "report:html": "marge reports/report.json --reportDir reports --inline",
    "allure:generate": "allure generate --clean allure-results -o allure-report",
    "allure:open": "allure open allure-report"
  }
}
